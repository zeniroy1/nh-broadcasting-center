<Window x:Class="HamShare.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HAMSHARE 수신기" Height="760" Width="1120" MinHeight="660" MinWidth="940"
        Background="#081321" Foreground="#EAF2FF" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0E2034"/>
        <SolidColorBrush x:Key="Line" Color="#203A57"/>
        <SolidColorBrush x:Key="Muted" Color="#91A7C0"/>
        <SolidColorBrush x:Key="Blue" Color="#55A7FF"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C4774"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#091827"/><Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="BorderBrush" Value="#294764"/><Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#203A57"/>
            <Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HAMSHARE" FontSize="40" FontWeight="Bold"/>
                <TextBlock Text="Galaxy S23+ → Windows 10 고속 로컬 수신기" Foreground="{StaticResource Muted}" FontSize="15"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#102D2B" CornerRadius="18" Padding="16,9" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FFC857" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="준비 중" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <GroupBox Header="연결 정보">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="PC 주소" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AddressText" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="1" Text="인증서 코드" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox x:Name="FingerprintText" Grid.Row="1" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Text="수신 폴더" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderText" IsReadOnly="True"/><Button Grid.Column="1" Content="변경" Click="ChooseFolder_Click" Margin="8,0,0,0"/></Grid>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="StartButton" Content="수신 시작" Click="StartButton_Click"/>
                        <Button x:Name="StopButton" Content="중지" Background="#5A3140" Click="StopButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="최초 등록 PIN">
                <StackPanel>
                    <TextBlock x:Name="PinText" Text="000000" FontFamily="Consolas" FontSize="48" FontWeight="Bold" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock x:Name="PinExpiryText" Text="10분 동안 유효" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    <Button Content="새 PIN 만들기" HorizontalAlignment="Center" Margin="0,16,0,0" Click="RefreshPin_Click"/>
                    <TextBlock Text="Android 앱에서 PC 주소, PIN, 인증서 코드를 입력하세요." TextWrapping="Wrap" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <GroupBox Header="전송 현황">
                <DataGrid x:Name="TransferGrid" ItemsSource="{Binding TransferRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Background="#091827" Foreground="#EAF2FF" BorderThickness="0" RowBackground="#0B1C2E" AlternatingRowBackground="#10243A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#203A57">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="진행" Binding="{Binding ProgressText}" Width="90"/>
                        <DataGridTextColumn Header="속도" Binding="{Binding SpeedText}" Width="100"/>
                        <DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
                <GroupBox Header="등록된 장치">
                    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ListBox x:Name="DeviceList" Background="#091827" Foreground="#EAF2FF" BorderThickness="0" DisplayMemberPath="DeviceName"/>
                        <Button Grid.Row="1" Content="선택 장치 등록 해제" Background="#5A3140" HorizontalAlignment="Left" Margin="0,10,0,0" Click="RemoveDevice_Click"/>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Row="2" Header="로그" Margin="0">
                    <ListBox x:Name="LogList" Background="#091827" Foreground="#91A7C0" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>

